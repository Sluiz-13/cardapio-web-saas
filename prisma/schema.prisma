generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------
// Tenant
// -----------------------------
enum Plan {
  START
  PRO
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // usado na URL: /r/[slug]
  isOpen    Boolean  @default(true)
  timezone  String   @default("America/Sao_Paulo")
  plan      Plan     @default(START)
  active    Boolean  @default(true) // desativado pela plataforma = cardápio some do ar, admin bloqueado
  lastPaymentConfirmedAt DateTime?
  nextDueDate            DateTime? // vencimento fixo, se preenchido some a ser a fonte da verdade em vez do cálculo automático
  welcomeCouponCode      String? // cupom de assinatura aplicado só na 1ª cobrança
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pendingPlanRequest     Plan?    // plano que o dono pediu (upgrade/downgrade) — só vira `plan` de verdade quando o Super Admin confirma
  pendingPlanRequestedAt DateTime?
  payments               PlatformPayment[]

  adminUsers AdminUser[]
  categories Category[]
  products   Product[]
  orders     Order[]
  businessHours BusinessHours[]
  coupons Coupon[]
  tables     Table[]
  comandas   Comanda[]
  defaultDeliveryFeeCents Int             @default(0)
    serviceFeePercent       Int      @default(0) // taxa de serviço do garçom, só cobrada no fechamento de comanda (mesa)
  printKitchenCopy        Boolean  @default(true) // imprime uma 2ª via só pra cozinha (sem preço) além da via completa
  menuTheme               MenuTheme @default(CLASSIC) // visual do cardápio público — Premium é exclusivo do plano Pro
  deliveryFees            DeliveryFee[]
  drivers                 Driver[]
  cashSessions            CashSession[]
  insumos                 Insumo[]
  customers                Customer[]
  reservations             Reservation[]
  deliveryZones            DeliveryZone[]
  useDeliveryZones         Boolean @default(false) // liga o sistema novo de zona por mapa em vez da lista simples de bairro
  loyaltyPointsEnabled          Boolean @default(false)
  loyaltyPointsPerReal          Float   @default(0) // pontos ganhos por real gasto — aceita decimal (ex: 0.5)
  loyaltyPointsRedeemThreshold  Int     @default(0) // quantos pontos = 1 resgate
  loyaltyPointsRedeemValueCents Int     @default(0) // valor do desconto ao resgatar
  cashbackEnabled               Boolean @default(false)
  cashbackPercent               Int     @default(0) // % do pedido que volta como cashback
  dailyCounterEnabled           Boolean @default(false)
  dailyCounterNext              Int     @default(1) // próximo número a atribuir; o caixa reseta manualmente quando quiser

  pixKey           String?
  pixKeyType       String?
  pixMerchantName  String?
  pixMerchantCity  String?

  phone           String?
  address         String?
  avgDeliveryTime String?
  contactEmail String?
  logoUrl   String?

  // Configuração de impressão automática. MANUAL é o default seguro:
  // nenhum restaurante existente muda de comportamento com essa migration.
  printMethod PrintMethod @default(MANUAL)
  printerIp                String? // usado quando printMethod = AGENT (TCP/Wi-Fi)
  printerPort              Int?    @default(9100)
  printerBluetoothAddress  String? // MAC address da impressora pareada (Bluetooth Classic/SPP)
  printerBluetoothName     String? // nome amigável, só pra exibir na tela de Configurações
  printerQzName            String? // nome exato da impressora reconhecida pelo QZ Tray (Windows/Mac)

  @@map("restaurants")
}

enum PrintMethod {
  MANUAL // botão manual — comportamento atual, sempre disponível como fallback
  RAWBT  // dispara impressão via app RawBT instalado no celular do restaurante
  AGENT  // app Menuair Caixa (celular) — impressora Wi-Fi/Rede
  AGENT_BLUETOOTH // app Menuair Caixa (celular) — impressora Bluetooth
  QZ_TRAY // agente QZ Tray rodando no PC/notebook do balcão
}
model BusinessHours {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        // 0 = domingo, 1 = segunda, ... 6 = sábado
  isOpen       Boolean    @default(true)
  openTime     String     // formato "HH:mm", ex: "11:00"
  closeTime    String     // formato "HH:mm", ex: "22:00"

  @@unique([restaurantId, dayOfWeek])
  @@map("business_hours")
}

// -----------------------------
// Admin (dono/staff do restaurante)
// -----------------------------
enum AdminRole {
  OWNER
  GERENTE
  CAIXA
  STAFF // continua sendo o "garçom" — só acessa /garcom, nunca /admin
}

enum MenuTheme {
  CLASSIC
  PREMIUM
}

model AdminUser {
  id           String    @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  createdAt    DateTime  @default(now())

  openedCashSessions CashSession[] @relation("CashSessionOpenedBy")
  closedCashSessions CashSession[] @relation("CashSessionClosedBy")

  @@index([restaurantId])
  @@map("admin_users")
}

// -----------------------------
// Cardápio
// -----------------------------
model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  order        Int        @default(0)
  products     Product[]

  @@index([restaurantId])
  @@map("categories")
}

model Product {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  priceCents   Int // preço SEMPRE em centavos (nunca float pra dinheiro)
  imageUrl     String?
  active       Boolean    @default(true)
  visibleToCustomer Boolean @default(true) // aparece no cardápio público (delivery/QR)
  visibleToStaff    Boolean @default(true) // aparece no app do garçom
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  removableOptions ProductRemovable[]
  extraOptions     ProductExtra[]
  maxAccompaniments Int? // se preenchido, vira "Monte seu prato": limita quantos extraOptions o cliente pode escolher
  optionGroups     ProductOptionGroup[] // sistema avançado (assistente em etapas) — convive com extraOptions, não substitui
  recipeItems      ProductRecipeItem[]  // ficha técnica — quais insumos e quanto o prato consome
  orderItems       OrderItem[]
  availableDays Int[] @default([])
  coupons Coupon[]
  order Int @default(0) // ordem de exibição DENTRO da categoria, não global

  @@index([restaurantId])
  @@index([categoryId])
  @@map("products")
}

model ProductRemovable {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // ex: "Cebola", "Salada"

  @@map("product_removables")
}

model ProductExtra {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  priceCents Int

  @@map("product_extras")
}


enum OptionGroupPricingStyle {
  SUM     // soma o preço de cada item selecionado
  FIXED   // preço fixo pro grupo, não importa quantos itens escolher
  HIGHEST // cobra só o item mais caro entre os selecionados
}

model ProductOptionGroup {
  id           String                  @id @default(cuid())
  productId    String
  product      Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String                  // ex: "Opção de Salmão", "Acompanhamentos"
  minSelect    Int                     @default(0)
  maxSelect    Int?                    // null = sem limite
  pricingStyle OptionGroupPricingStyle @default(SUM)
  fixedPriceCents Int?                 // só usado quando pricingStyle = FIXED — ignora preço dos itens, cobra esse valor
  order        Int                     @default(0) // ordem das etapas do assistente

  items ProductOptionItem[]

  @@index([productId])
  @@map("product_option_groups")
}

model ProductOptionItem {
  id         String             @id @default(cuid())
  groupId    String
  group      ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  priceCents Int
  order      Int                @default(0)

  @@index([groupId])
  @@map("product_option_items")
}

model Insumo {
  id           String   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  unit         String   // "kg", "g", "L", "ml", "un" — texto livre, mantém simples
  currentStock Float    @default(0)
  minStock     Float    @default(0) // abaixo disso, entra no alerta de estoque baixo
  costPerUnit  Int      // em centavos, custo por unidade de medida
  createdAt    DateTime @default(now())

  recipeItems ProductRecipeItem[]
  movements   StockMovement[]

  @@index([restaurantId])
  @@map("insumos")
}

model Customer {
  id                   String   @id @default(cuid())
  restaurantId         String
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name                 String
  phone                String   // login é telefone + senha — único por restaurante, não globalmente
  passwordHash         String
  loyaltyPoints        Int      @default(0)
  cashbackBalanceCents Int      @default(0)
  street               String?
  number               String?
  complement           String?
  neighborhood         String?
  city                 String?
  referenceNote        String?
  createdAt            DateTime @default(now())

  orders               Order[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@map("customers")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
}

model Reservation {
  id            String            @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  partySize     Int
  reservedFor   DateTime
  note          String?
  status        ReservationStatus @default(PENDING)
  tableId       String?
  table         Table?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@index([restaurantId])
  @@map("reservations")
}

model ProductRecipeItem {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  insumoId  String
  insumo    Insumo  @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  quantity  Float   // quantidade do insumo usada por unidade do produto

  @@index([productId])
  @@index([insumoId])
  @@map("product_recipe_items")
}

enum StockMovementType {
  ENTRADA      // compra/reposição
  SAIDA_VENDA  // baixa automática por venda
  AJUSTE       // correção manual (perda, contagem, etc.)
}

model StockMovement {
  id        String            @id @default(cuid())
  insumoId  String
  insumo    Insumo            @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Float             // sempre positivo — o "type" já diz se soma ou subtrai
  note      String?
  orderId   String?           // se for baixa por venda, referencia o pedido de origem
  createdAt DateTime          @default(now())

  @@index([insumoId])
  @@map("stock_movements")
}

// -----------------------------
// Pedido
// -----------------------------
enum OrderStatus {
  PENDING_PAYMENT
  NEW
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum DeliveryType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum ComandaStatus {
  OPEN
  CLOSED
}

model Table {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  label        String // ex: "Mesa 1", "Varanda 3"
  createdAt    DateTime   @default(now())

  orders       Order[]
  comandas     Comanda[]
  reservations Reservation[]

  @@index([restaurantId])
  @@map("tables")
}

model Comanda {
  id           String        @id @default(cuid())
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      String
  table        Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status       ComandaStatus @default(OPEN)
  openedAt     DateTime      @default(now())
  closedAt     DateTime?
  paymentMethod PaymentMethod? // preenchido só no fechamento — forma de pagamento real usada pelo cliente

  orders Order[]

  // Só pode existir 1 comanda ABERTA por mesa por vez — evita duas comandas
  // simultâneas na mesma mesa por corrida de requisição (dois pedidos quase
  // juntos tentando abrir comanda ao mesmo tempo).
  @@index([restaurantId, status])
  @@index([tableId, status])
  @@map("comandas")
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
}


model Order {
  id            String        @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String?
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status        OrderStatus   @default(PENDING_PAYMENT)
  totalCents    Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  couponCode    String?
  discountCents Int     @default(0)
  loyaltyDiscountCents Int @default(0)
  cashbackUsedCents    Int @default(0)
  dailyNumber   Int?    // número sequencial manual (opcional) — null se o restaurante não usa
  deliveryFeeCents Int @default(0)

  deliveryType  DeliveryType  @default(DELIVERY)
  paymentMethod PaymentMethod
  paymentConfirmed Boolean @default(true)

  // Preenchido só quando deliveryType = DINE_IN
  tableId   String?
  table     Table?   @relation(fields: [tableId], references: [id], onDelete: SetNull)
  comandaId String?
  comanda   Comanda? @relation(fields: [comandaId], references: [id], onDelete: SetNull)

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  // Preenchido só quando deliveryType = DELIVERY (validado na API, não no banco)
  street        String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  zipCode       String?
  referenceNote String?

  items   OrderItem[]
  payment Payment?
  statusHistory OrderStatusHistory[]
  changeForCents Int?

  // null = ainda não impresso. Usado pelos 3 métodos de impressão (manual,
  // RawBT, Agent) pra evitar imprimir o mesmo pedido duas vezes.
  printedAt DateTime?

  @@index([restaurantId, status])
  @@index([restaurantId, printedAt])
  @@map("orders")
}

model Driver {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  orders Order[]

  @@index([restaurantId])
  @@map("drivers")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SANGRIA
  SUPRIMENTO
}

model CashSession {
  id            String            @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  openedById    String
  openedBy      AdminUser         @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  openingAmountCents Int

  closedById    String?
  closedBy      AdminUser?        @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  closingAmountCents  Int?
  expectedAmountCents Int?

  status        CashSessionStatus @default(OPEN)
  openedAt      DateTime          @default(now())
  closedAt      DateTime?
  notes         String?

  movements     CashMovement[]

  @@index([restaurantId])
  @@map("cash_sessions")
}

model CashMovement {
  id            String           @id @default(cuid())
  cashSessionId String
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  type          CashMovementType
  amountCents   Int
  note          String?
  createdAt     DateTime         @default(now())

  @@index([cashSessionId])
  @@map("cash_movements")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String // snapshot do nome no momento da compra
  categoryName  String? // snapshot da categoria no momento da compra
  unitPriceCents Int    // snapshot do preço no momento da compra
  qty           Int
  removedItems  Json    @default("[]") // string[]
  extras        Json    @default("[]") // { name, priceCents }[]
  selectedOptions Json  @default("[]") // { groupName, pricingStyle, chargedCents, items: { name, priceCents }[] }[] — snapshot dos grupos de opção

  @@map("order_items")
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  changedAt DateTime @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model DeliveryFee {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  neighborhood String     // como o admin digitou, exibido na tela
  feeCents     Int
  active       Boolean    @default(true) // false = entrega pausada pra esse bairro (cliente é orientado a chamar no WhatsApp)
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, neighborhood])
  @@map("delivery_fees")
}

model DeliveryZone {
  id                String   @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name              String
  feeCents          Int
  minOrderCents     Int?
  estimatedMinutes  Int?
  neighborhoods     String[] // nomes de bairro cobertos por essa área — usado na busca por texto
  geoJson           Json     // o polígono desenhado no mapa (GeoJSON Polygon)
  active            Boolean  @default(true)
  pauseReason       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([restaurantId])
  @@map("delivery_zones")
}

// -----------------------------
// Pagamento
// -----------------------------
enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String // "mercadopago" | "efi" | "pagarme" ...
  providerPaymentId String? // id retornado pelo gateway
  status            PaymentStatus @default(PENDING)
  amountCents       Int
  rawPayload        Json? // payload bruto do último webhook recebido (auditoria)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([provider, providerPaymentId])
  @@map("payments")
}

// -----------------------------
// Cupom de desconto
// -----------------------------

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id            String       @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  code          String       // salvo em maiúsculas, comparação case-insensitive na aplicação
  discountType  DiscountType
  discountValue Int          // porcentagem (0-100) OU centavos, depende do discountType
  active        Boolean      @default(true)
  minOrderCents Int?         // pedido mínimo pra cupom valer (opcional)
  maxUsage      Int?         // null = sem limite de usos
  usageCount    Int          @default(0)
  oncePerCustomer Boolean    @default(false) // limita a 1 uso por telefone de cliente, além do limite geral
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, code])
  @@map("coupons")
}

// -----------------------------
// Cupom de desconto boas vindas
// -----------------------------

model PlatformCoupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int // porcentagem (0-100) OU centavos, depende do discountType
  active        Boolean      @default(true)
  maxUsage      Int?
  usageCount    Int          @default(0)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  @@map("platform_coupons")
}

// -----------------------------
// Plataforma (dono do SaaS — separado de AdminUser)
// -----------------------------
model PlatformAdmin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("platform_admins")
}


// -----------------------------
// Pix Saas
// -----------------------------

model PlatformSettings {
  id              String   @id @default("singleton")
  pixKey          String?
  pixKeyType      String?
  pixMerchantName String?
  pixMerchantCity String?
  updatedAt       DateTime @updatedAt

  @@map("platform_settings")
}


model PlatformPayment {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amountCents  Int
  confirmedAt  DateTime   @default(now())

  @@index([restaurantId])
  @@index([confirmedAt])
  @@map("platform_payments")
}