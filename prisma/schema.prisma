generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------
// Tenant
// -----------------------------
enum Plan {
  START
  PRO
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // usado na URL: /r/[slug]
  isOpen    Boolean  @default(true)
  timezone  String   @default("America/Sao_Paulo")
  plan      Plan     @default(START)
  active    Boolean  @default(true) // desativado pela plataforma = cardápio some do ar, admin bloqueado
  lastPaymentConfirmedAt DateTime? // null = nunca pagou; usado só pra mostrar pendência no painel, não bloqueia nada sozinho
  welcomeCouponCode      String? // cupom de assinatura aplicado só na 1ª cobrança
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pendingPlanRequest     Plan?    // plano que o dono pediu (upgrade/downgrade) — só vira `plan` de verdade quando o Super Admin confirma
  pendingPlanRequestedAt DateTime?
  payments               PlatformPayment[]

  adminUsers AdminUser[]
  categories Category[]
  products   Product[]
  orders     Order[]
  businessHours BusinessHours[]
  coupons Coupon[]
  defaultDeliveryFeeCents Int             @default(0)
  deliveryFees            DeliveryFee[]

  pixKey           String?
  pixKeyType       String?
  pixMerchantName  String?
  pixMerchantCity  String?

  phone           String?
  address         String?
  avgDeliveryTime String?
  contactEmail String?
  logoUrl   String?

  // Configuração de impressão automática. MANUAL é o default seguro:
  // nenhum restaurante existente muda de comportamento com essa migration.
  printMethod PrintMethod @default(MANUAL)
  printerIp   String? // usado só quando printMethod = AGENT
  printerPort Int?    @default(9100) // porta padrão ESC/POS sobre TCP (RAW/9100)

  @@map("restaurants")
}

enum PrintMethod {
  MANUAL // botão manual — comportamento atual, sempre disponível como fallback
  RAWBT  // dispara impressão via app RawBT instalado no celular do restaurante
  AGENT  // serviço local (PC/notebook) que fala ESC/POS direto com a impressora
}

model BusinessHours {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int        // 0 = domingo, 1 = segunda, ... 6 = sábado
  isOpen       Boolean    @default(true)
  openTime     String     // formato "HH:mm", ex: "11:00"
  closeTime    String     // formato "HH:mm", ex: "22:00"

  @@unique([restaurantId, dayOfWeek])
  @@map("business_hours")
}

// -----------------------------
// Admin (dono/staff do restaurante)
// -----------------------------
enum AdminRole {
  OWNER
  STAFF
}

model AdminUser {
  id           String    @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  createdAt    DateTime  @default(now())

  @@index([restaurantId])
  @@map("admin_users")
}

// -----------------------------
// Cardápio
// -----------------------------
model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  order        Int        @default(0)
  products     Product[]

  @@index([restaurantId])
  @@map("categories")
}

model Product {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  priceCents   Int // preço SEMPRE em centavos (nunca float pra dinheiro)
  imageUrl     String?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  removableOptions ProductRemovable[]
  extraOptions     ProductExtra[]
  orderItems       OrderItem[]
  availableDays Int[] @default([])
  coupons Coupon[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("products")
}

model ProductRemovable {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // ex: "Cebola", "Salada"

  @@map("product_removables")
}

model ProductExtra {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  priceCents Int

  @@map("product_extras")
}

// -----------------------------
// Pedido
// -----------------------------
enum OrderStatus {
  PENDING_PAYMENT
  NEW
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
}


model Order {
  id            String        @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  status        OrderStatus   @default(PENDING_PAYMENT)
  totalCents    Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  couponCode    String?
  discountCents Int     @default(0)
  deliveryFeeCents Int @default(0)

  deliveryType  DeliveryType  @default(DELIVERY)
  paymentMethod PaymentMethod
  paymentConfirmed Boolean @default(true)

  // Preenchido só quando deliveryType = DELIVERY (validado na API, não no banco)
  street        String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  zipCode       String?
  referenceNote String?

  items   OrderItem[]
  payment Payment?
  statusHistory OrderStatusHistory[]
  changeForCents Int?

  // null = ainda não impresso. Usado pelos 3 métodos de impressão (manual,
  // RawBT, Agent) pra evitar imprimir o mesmo pedido duas vezes.
  printedAt DateTime?

  @@index([restaurantId, status])
  @@index([restaurantId, printedAt])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String // snapshot do nome no momento da compra
  unitPriceCents Int    // snapshot do preço no momento da compra
  qty           Int
  removedItems  Json    @default("[]") // string[]
  extras        Json    @default("[]") // { name, priceCents }[]

  @@map("order_items")
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  changedAt DateTime @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model DeliveryFee {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  neighborhood String     // como o admin digitou, exibido na tela
  feeCents     Int
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, neighborhood])
  @@map("delivery_fees")
}

// -----------------------------
// Pagamento
// -----------------------------
enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String // "mercadopago" | "efi" | "pagarme" ...
  providerPaymentId String? // id retornado pelo gateway
  status            PaymentStatus @default(PENDING)
  amountCents       Int
  rawPayload        Json? // payload bruto do último webhook recebido (auditoria)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([provider, providerPaymentId])
  @@map("payments")
}

// -----------------------------
// Cupom de desconto
// -----------------------------

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id            String       @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  code          String       // salvo em maiúsculas, comparação case-insensitive na aplicação
  discountType  DiscountType
  discountValue Int          // porcentagem (0-100) OU centavos, depende do discountType
  active        Boolean      @default(true)
  minOrderCents Int?         // pedido mínimo pra cupom valer (opcional)
  maxUsage      Int?         // null = sem limite de usos
  usageCount    Int          @default(0)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, code])
  @@map("coupons")
}

// -----------------------------
// Cupom de desconto boas vindas
// -----------------------------

model PlatformCoupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int // porcentagem (0-100) OU centavos, depende do discountType
  active        Boolean      @default(true)
  maxUsage      Int?
  usageCount    Int          @default(0)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  @@map("platform_coupons")
}

// -----------------------------
// Plataforma (dono do SaaS — separado de AdminUser)
// -----------------------------
model PlatformAdmin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("platform_admins")
}


// -----------------------------
// Pix Saas
// -----------------------------

model PlatformSettings {
  id              String   @id @default("singleton")
  pixKey          String?
  pixKeyType      String?
  pixMerchantName String?
  pixMerchantCity String?
  updatedAt       DateTime @updatedAt

  @@map("platform_settings")
}


model PlatformPayment {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amountCents  Int
  confirmedAt  DateTime   @default(now())

  @@index([restaurantId])
  @@index([confirmedAt])
  @@map("platform_payments")
}